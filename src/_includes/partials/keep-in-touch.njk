{#-
  The articles sentence is the consent the signup API records. It must stay
  word for word (functions/email/logic.mjs KEEP_IN_TOUCH_WORDING). There is
  no launch-tag field on that API, so this form does not send one.
  The beta checkbox is not offered. The script still sends betaConsent false.
-#}
<section class="keep-in-touch" id="signup" aria-labelledby="signup-heading">
  <h2 class="keep-in-touch__title" id="signup-heading">{{ kitTitle or "Stay in the loop" }}</h2>
  {%- set signupIntro = kitIntro or "Get practical planning articles by email, plus launch updates for Practical Stock Planner and Practical Demand Planner." %}
  {%- if signupIntro %}
  <p class="keep-in-touch__intro">{{ signupIntro }}</p>
  {%- endif %}
  <form class="keep-in-touch__form" id="keep-in-touch-form" novalidate>
    <p class="keep-in-touch__status" role="status"></p>
    <label class="sim-field" for="keep-in-touch-email">
      Email address
      <input id="keep-in-touch-email" name="email" type="email" autocomplete="email" maxlength="254" />
    </label>
    <p class="keep-in-touch__consent">Send me new articles from Practical Supply Chain Planning. Unsubscribe any time.</p>
    <p class="sim-meta">One email now and then. <a href="/privacy/">Privacy</a></p>
    <div class="sim-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-appearance="interaction-only"></div>
    <div class="sim-hp" aria-hidden="true">
      <label for="keep-in-touch-company">Company</label>
      <input id="keep-in-touch-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="sim-button" type="submit">Keep me posted</button>
  </form>
  <p class="keep-in-touch__sent" hidden>You're on the list. Thanks!</p>
</section>
<script>
  (function () {
    window.pscpTurnstileQueue = window.pscpTurnstileQueue || [];
    if (typeof window.pscpTurnstileLoaded !== "function") {
      window.pscpTurnstileLoaded = function () {
        var waiting = window.pscpTurnstileQueue;
        window.pscpTurnstileQueue = {
          push: function (fn) {
            fn();
          },
        };
        if (waiting && waiting.forEach) {
          waiting.forEach(function (fn) {
            fn();
          });
        }
      };
    }
    if (!document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
      var script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=pscpTurnstileLoaded";
      script.async = true;
      document.head.appendChild(script);
    }
  })();
</script>
<script src="/assets/keep-in-touch.js?v={{ site.cssVersion }}"></script>
