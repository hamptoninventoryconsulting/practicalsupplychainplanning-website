---
layout: layouts/base.njk
---
<h1 class="page-title">Blog</h1>
<p class="tagline">
  Practical articles on inventory planning, supply chain decisions, and
  operational planning.
</p>

<div id="blog-posts" class="blog-list">
  {% for post in collections.postsByDate %}
  <a class="blog-post-card" href="/blog/{{ post.fileSlug }}/">
    <div class="blog-post-card__media">
      <img
        class="blog-post-card__image"
        src="/images/{{ post.data.featured_image }}"
        alt=""
        width="240"
        height="175"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="blog-post-card__body">
      <h2 class="blog-post-card__title">{{ post.data.title }}</h2>
      <p class="blog-post-card__summary">{{ post.data.summary }}</p>
      <p class="blog-post-card__meta">{% if post.data.published_datetime %}<time class="blog-post-card__meta-item" datetime="{{ post.data.published_datetime | isoDate }}">{{ post.data.published_datetime | displayDate }}</time>{% endif %}{% if post.data.reading_time %}{% if post.data.published_datetime %}<span class="blog-post-card__meta-sep" aria-hidden="true">•</span>{% endif %}<span class="blog-post-card__meta-item">{{ post.data.reading_time | readingLabel }}</span>{% endif %}{% if post.data.author %}{% if post.data.published_datetime or post.data.reading_time %}<span class="blog-post-card__meta-sep" aria-hidden="true">•</span>{% endif %}<span class="blog-post-card__meta-item">{{ post.data.author }}</span>{% endif %}</p>
      <span class="blog-post-card__cta">Read Article →</span>
    </div>
  </a>
  {% endfor %}
</div>
{{ content | safe }}
