---json
{
  "layout": "layouts/sales.njk",
  "title": "Practical Stock Planner, US$49/month",
  "description": "Checkout for Practical Stock Planner.",
  "canonical": "https://practicalsupplychainplanning.com/buy/",
  "robots": "noindex",
  "eleventyExcludeFromCollections": true,
  "permalink": "/buy/"
}
---
{%- set checkoutConfigured = ("REPLACE_ME" not in paddle.clientToken) and (paddle.campaigns.default.priceId) and ("REPLACE_ME" not in paddle.campaigns.default.priceId) -%}
<h1 class="page-title">Practical Stock Planner, US$49/month</h1>
<p class="sales-licence" id="licence-note">
  Each user is a separate licence at US$49/month. One user is one computer.
  Tax, where applicable, is calculated at checkout.
</p>
<div class="sales-summary" role="status" aria-live="polite" aria-atomic="true">
  <p class="sales-standalone" id="standalone-note" hidden>
    Each user gets their own stand-alone copy. Data and plans stay on that computer and aren't shared between users.
  </p>
  <p class="sales-quote" id="checkout-total">1 user × US$49/month = US$49/month (plus any applicable tax)</p>
</div>
<div class="sales-users">
  <button
    type="button"
    class="sales-team-toggle"
    id="team-toggle"
    aria-expanded="false"
    aria-controls="user-count-field"
  >
    <span class="sales-team-toggle__mark" aria-hidden="true"></span>
    <span class="sales-team-toggle__label">Buying for a team?</span>
  </button>
  <div class="sales-users__field" id="user-count-field" hidden>
    <label for="user-count">How many users?</label>
    <input
      id="user-count"
      type="number"
      inputmode="numeric"
      min="1"
      max="10"
      step="1"
      value="1"
      autocomplete="off"
      aria-describedby="licence-note"
    >
  </div>
</div>
<p class="sales-checkout">
  <button
    type="button"
    class="sales-button sales-button--action"
    id="checkout-button"
    disabled
    {% if not checkoutConfigured %}aria-describedby="checkout-note"{% endif %}
  >
    Checkout
  </button>
</p>
<p class="sales-note" id="checkout-note"{% if checkoutConfigured %} hidden{% endif %}>
  checkout not configured
</p>
<p class="sales-note" id="checkout-load-note" hidden>
  Checkout couldn't load. Please refresh, or email
  <a class="support-email" href="mailto:support@practicalsupplychainplanning.com">support@practicalsupplychainplanning.com</a>.
</p>
<noscript>
  <p>
    Checkout needs JavaScript. Email
    <a class="support-email" href="mailto:support@practicalsupplychainplanning.com">support@practicalsupplychainplanning.com</a>
    and we will help you subscribe.
  </p>
</noscript>
<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
<script type="application/json" id="paddle-config">
{{ paddle | dump | safe }}
</script>
<script src="/assets/buy-checkout.js?v={{ site.cssVersion }}"></script>
